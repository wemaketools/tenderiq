# TenderIQ: LOCAL environment catalog (architecture brief §8.2). Copy to .env.local (git-ignored).
#
# The Stage A static prototype needs NO .env.local (DD-50): `npm run dev:prototype` runs without one. These are the
# variables of the server config module (src/server/lib/config), kept for Stage B, when they come from
# `npx supabase status -o env` for the local Docker stack. Placeholders only in this file: no key, token or
# password is ever committed. Stage B adds its variables to the config schema and here in the same change.

APP_ENV=local
LOG_LEVEL=info

# Local Supabase API (Auth). The JWT issuer is http://127.0.0.1:54321/auth/v1.
SUPABASE_URL=http://127.0.0.1:54321
# ANON_KEY from `npx supabase status -o env`.
SUPABASE_ANON_KEY=<local-anon-key>
# SERVICE_ROLE_KEY from `npx supabase status -o env`. Server only (auth:personas uses it).
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Browser-safe values for the SPA (Vite reads this root file).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key>
