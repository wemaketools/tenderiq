# TenderIQ: LOCAL environment catalog (architecture brief §8.2). Copy to .env.local (git-ignored).
#
# Values come from `npx supabase status -o env` for the local Docker stack (`npm run supabase:start`);
# .\run.ps1 writes them for you. Placeholders only in this file: no key, token or password is ever committed.
# Stage A subset (DD-43): the mock API verifies real Supabase JWTs and `npm run auth:personas` provisions the
# demo accounts. Stage B adds its variables to the config schema and here in the same change.

APP_ENV=local
LOG_LEVEL=info

# Local Supabase API (Auth). The JWT issuer is http://127.0.0.1:54321/auth/v1.
SUPABASE_URL=http://127.0.0.1:54321
# ANON_KEY from `npx supabase status -o env`.
SUPABASE_ANON_KEY=<local-anon-key>
# SERVICE_ROLE_KEY from `npx supabase status -o env`. Server only (auth:personas uses it).
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Browser-safe values for the SPA (Vite reads this root file).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key>
