{
  "name": "@tenderiq/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "TenderIQ end-to-end tests (Playwright + axe). Stage A runs the 'prototype' project against the mock API.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "playwright test",
    "test:prototype": "playwright test --project prototype",
    "typecheck": "tsc -p tsconfig.json",
    "browsers:install": "playwright install chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3"
  }
}
