{
  "name": "tenderiq",
  "version": "0.1.0",
  "private": true,
  "description": "TenderIQ (Tender Intelligence): multi-organization tender management. Stage A: UI prototype on typed API contracts and a static-data mock API.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "src/ui",
    "e2e_tests"
  ],
  "scripts": {
    "supabase:start": "node scripts/db/ensure-signing-keys.mjs && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "auth:personas": "tsx --env-file-if-exists=.env.local scripts/dev/seed-auth-personas.ts",
    "dev:prototype": "node scripts/dev/dev-prototype.mjs",
    "dev:mock-api": "tsx --env-file-if-exists=.env.local scripts/dev/serve-mock-api.ts --port 3001",
    "typecheck": "tsc -p tsconfig.server.json",
    "typecheck:ui": "npm run typecheck -w @tenderiq/ui",
    "lint": "eslint --no-error-on-unmatched-pattern api src/server src/contracts src/mock-api scripts",
    "lint:ui": "npm run lint -w @tenderiq/ui",
    "format:ui": "npm run format -w @tenderiq/ui",
    "build:ui": "npm run build -w @tenderiq/ui",
    "build": "npm run typecheck && npm run build:ui",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "npm run test -w @tenderiq/ui",
    "docs:api": "tsx scripts/docs/generate-openapi.ts",
    "ci:security": "tsx scripts/ci/scan-secrets.ts && tsx scripts/ci/scan-bundle.ts",
    "ci:test:ui": "npm run test -w @tenderiq/ui -- --reporter=default --reporter=json --outputFile.json=../../.test-results/vitest-ui.json && tsx scripts/ci/assert-test-run.ts --report .test-results/vitest-ui.json --min-tests 1360",
    "ci:test:unit": "vitest run --project unit --reporter=default --reporter=json --outputFile.json=.test-results/vitest-unit.json && tsx scripts/ci/assert-test-run.ts --report .test-results/vitest-unit.json --min-tests 2690",
    "test:e2e:prototype": "playwright test -c e2e_tests/playwright.config.ts --project prototype",
    "verify": "npm run typecheck && npm run typecheck:ui && npm run lint && npm run lint:ui && npm run test && npm run test:ui && npm run build:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.11",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "supabase": "2.118.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
